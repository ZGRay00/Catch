{
  "manifest_version": 3,
  "name": "PokéCatch 保持激活",
  "version": "1.0.1",
  "description": "通过浏览器原生模拟聚焦功能，让一个 PokéCatch 标签页在切走或最小化后保持激活。",
  "minimum_chrome_version": "118",
  "permissions": ["debugger", "storage"],
  "host_permissions": ["https://pokecatch-online.app/*", "https://pokecatch-online.netlify.app/*", "https://pokecatch-online.pages.dev/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "PokéCatch 保持激活",
    "default_popup": "popup.html"
  }
}
